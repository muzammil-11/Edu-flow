      "usage": "Highlights, 'Apply Now' CTAs, Progress Indicators"
    },
    "neutral": {
      "surface": "#ffffff",
      "text_primary": "#0f172a",
      "text_secondary": "#475569",
      "border": "#e2e8f0"
