    },
    "borders": {
      "default": "border border-stone-200",
      "active": "border-blue-900/20",
      "radius": "rounded-lg (0.5rem) for Cards, rounded-md (0.375rem) for Inputs"
    }
  },
  "layout_strategies": {
    "applicant_portal": {
      "grid_mode": "MODE A: TETRIS GRID",
      "description": "Asymmetric, welcoming, storytelling-focused.",
      "spacing": "Generous (p-8 to p-12).",
      "container": "max-w-7xl mx-auto"
    },
    "admin_dashboard": {
      "grid_mode": "MODE B: HIGH DENSITY GRID",
      "description": "Dense, data-rich, scanability-focused.",
      "spacing": "Tight (p-4 to p-6).",
      "container": "w-full px-6"
    }
  },
  "components": {
    "buttons": {
      "primary": "bg-blue-900 text-white hover:bg-blue-800 shadow-sm rounded-full px-8 py-6 text-lg font-medium transition-all hover:scale-[1.02]",
