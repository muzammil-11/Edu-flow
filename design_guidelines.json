{
  "identity": {
    "persona": "E1",
    "philosophy": "Fusion over Imitation. Emotion First. Content is King.",
    "anti_patterns": [
      "Purple/Teal for CTA",
      "Inter font for Headings",
      "Center-Everything Disease",
      "Gradient Overload (>20%)",
      "Generic 'Bootstrap' Columns"
    ]
  },
  "typography": {
    "headings": {
      "font_family": "Merriweather, serif",
      "weights": ["300", "400", "700", "900"],
      "usage": "All H1-H3 headings. Use 'Light' (300) for elegance or 'Black' (900) for impact.",
      "tracking": "tracking-tight"
    },
    "body": {
      "font_family": "Plus Jakarta Sans, sans-serif",
      "weights": ["400", "500", "600"],
      "usage": "Body text, UI elements, buttons, data tables.",
      "tracking": "tracking-normal"
    },
    "mono": {
      "font_family": "JetBrains Mono, monospace",
      "usage": "Application IDs, Status Codes, Technical Data."
    }
  },
  "colors": {
    "palette_name": "Modern Ivy League",
    "theme_strategy": "Light Mode Default (Trust/Clarity) with Dark Mode Option",
    "primary": {
      "name": "Oxford Blue",
      "hex": "#1e3a8a",
      "tailwind": "bg-blue-900",
      "usage": "Primary Buttons, Active States, Key Brand Elements"
    },
    "secondary": {
      "name": "Warm Sand",
      "hex": "#f5f5f4",
      "tailwind": "bg-stone-100",
